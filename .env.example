# -----------------------------------------------------------------------------
# VettedRent deployment configuration template
# Copy this file to .env and fill in real values. Do not commit .env.
# -----------------------------------------------------------------------------

# Supabase
# Required to open /underwriting. NEXT_PUBLIC_ values are visible in the browser.
# The anon key starts the lodger session. The service role key stays on the server,
# verifies that session, and bypasses RLS. Use the project URL, not https://supabase.co.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Use a test secret key locally. Use a live secret key only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Pin the one weekly-stay product. Example: prod_vettedrent_stay
# When empty, the API reuses the active product tagged vettedrent_key=weekly_stay,
# or creates that product once. Weekly amounts reuse a price by lookup key.
STRIPE_WEEKLY_PRODUCT_ID=

# Twilio transactional SMS. Leave blank locally to log warnings instead of sending.
# TWILIO_PHONE_NUMBER and profiles.phone must be E.164, for example +12025550123.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Seam smart locks
SEAM_API_KEY=

# Plaid sandbox. Required to open the bank window on /underwriting.
# PLAID_SECRET must be the sandbox secret while PLAID_ENV=sandbox.
# Keep PLAID_ENV on its own line. An inline comment becomes part of the value.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Enterprise placement portal
# Shared bearer token for partner agencies. Generate a long random string.
ENTERPRISE_PORTAL_KEY=
