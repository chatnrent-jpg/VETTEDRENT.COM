# -----------------------------------------------------------------------------
# VettedRent deployment configuration template
# Copy this file to .env and fill in real values. Do not commit .env.
# -----------------------------------------------------------------------------

# Supabase
# NEXT_PUBLIC_ values are visible in the browser. The anon key is the client key
# used by useLodgerPass. The service role key stays on the server and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Use a test secret key locally. Use a live secret key only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Pin the one weekly-stay product. Example: prod_vettedrent_stay
# When empty, the API reuses the active product tagged vettedrent_key=weekly_stay,
# or creates that product once. Weekly amounts reuse a price by lookup key.
STRIPE_WEEKLY_PRODUCT_ID=

# Twilio transactional SMS. Leave blank locally to log warnings instead of sending.
# TWILIO_PHONE_NUMBER and profiles.phone must be E.164, for example +12025550123.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Seam smart locks
SEAM_API_KEY=

# Plaid cash-flow underwriting
# PLAID_ENV must be sandbox, development, or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Enterprise placement portal
# Shared bearer token for partner agencies. Generate a long random string.
ENTERPRISE_PORTAL_KEY=
